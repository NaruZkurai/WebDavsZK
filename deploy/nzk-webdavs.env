# TEMPLATE ONLY — this repo copy is NOT your live config.
# Install a copy to /etc/nzk-webdavs/nzk-webdavs.env and edit THAT file, so
# `git pull` never overwrites or conflicts with your settings.
#
# systemd EnvironmentFile for nzk-webdavs (/etc/nzk-webdavs/nzk-webdavs.env)
# Every variable maps 1:1 to a --flag (see `nzk-webdavs --help`).

NZK_WEBDAVS_BIND=0.0.0.0:8443
NZK_WEBDAVS_ROOT=/srv/webdav
NZK_WEBDAVS_PREFIX=
NZK_WEBDAVS_CERT=/etc/nzk-webdavs/server.crt
NZK_WEBDAVS_KEY=/etc/nzk-webdavs/server.key
NZK_WEBDAVS_AUTH_USER=webdav
NZK_WEBDAVS_AUTH_PASS=change-me-please
NZK_WEBDAVS_PRINCIPAL=nzk-webdavs
