# nzk-webdavs runtime configuration.
#
# On first launch, launch.sh copies this example to `config/env` — THAT is the
# file you actually edit. `config/env` is gitignored, so `git pull` / updates
# never conflict with your local settings (no stashing needed).
#
# Every variable maps 1:1 to a --flag (see `nzk-webdavs --help`). Command-line
# flags take precedence over these values for one-off overrides.

# Address to bind, e.g. 0.0.0.0:8443 or [::]:8443
NZK_WEBDAVS_BIND=0.0.0.0:8443

# Root directory served over WebDAV
NZK_WEBDAVS_ROOT=/srv/webdav

# URL prefix to strip (empty = serve at root)
NZK_WEBDAVS_PREFIX=

# TLS certificate and private key (PEM).
# WARNING: these must resolve OUTSIDE NZK_WEBDAVS_ROOT — if a cert/key is inside
# the served root, clients could download it (including the private key). The
# server refuses to start in that case. On the server use
# /etc/nzk-webdavs/server.{crt,key}; for local dev, `certs/` beside the repo is
# fine as long as the root is not the repo itself.
NZK_WEBDAVS_CERT=certs/server.crt
NZK_WEBDAVS_KEY=certs/server.key

# SANs used when generating a self-signed cert (--gen-cert)
NZK_WEBDAVS_CERT_SAN=localhost,0.0.0.0,::1

# Basic auth (both must be set, or neither)
NZK_WEBDAVS_AUTH_USER=webdav
NZK_WEBDAVS_AUTH_PASS=change-me-please

# WebDAV lock principal
NZK_WEBDAVS_PRINCIPAL=nzk-webdavs

# Send TCP keep-alive probes on idle connections after this many seconds (0
# disables). Keeps connections alive through NATs/firewalls during long user
# pauses such as KIO's overwrite dialog. Default 60.
# NZK_WEBDAVS_KEEPALIVE_SECS=60

# Append logs to a file (in addition to stderr). Empty = stderr only.
# Level comes from RUST_LOG (e.g. debug) or --verbose; default is info, which
# includes one line per request (REQ method path -> status in ms from client to
# target IP).
# NZK_WEBDAVS_LOG_FILE=logs/nzk-webdavs.log

# Target IP shown in the request log (e.g. your public/NAT IP). Empty = use the
# connection's actual local address.
# NZK_WEBDAVS_TARGET_IP=192.0.2.10

# Auto-check for git updates and rebuild at launch (default 1). Set 0 to only
# warn. config/env, certs/ and webdav_root are gitignored, so pulls never
# conflict with local settings.
# NZK_WEBDAVS_AUTO_UPDATE=1

# fsync each finished upload before the atomic rename (maximum durability,
# but slower when moving many small files). Default off.
# NZK_WEBDAVS_FSYNC=false

# A SHA-256 of every uploaded file is recorded (user.nzk_webdavs.sha256 xattr)
# so uploads can be verified later. A client-provided OC-Checksum (SHA256) is
# verified before the file is finalized; a mismatch rejects the upload.

# Update-on-push webhook. When set, POST /.nzk-webdavs-update with header
# X-Nzk-Update-Token: <secret> triggers a git pull + rebuild + restart, so the
# server updates the moment a client pushes. Leave unset to disable.
# NZK_WEBDAVS_UPDATE_SECRET=
# Command run on webhook trigger (default: scripts/update.sh). Point this at
# whatever restarts YOUR service, e.g. the user-level updater on a desktop box.
# NZK_WEBDAVS_UPDATE_CMD=scripts/update.sh
# For ./push.sh (on the machine that pushes): receivers to notify after a push.
# NZK_WEBDAVS_RECEIVERS="https://192.0.2.1:8443 https://192.0.2.2:51337"
